# =============================================================================
# Dockerfile for Render.com Deployment
# =============================================================================
# Optimized for Render's infrastructure with proper health checks
# =============================================================================

FROM python:3.12-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    postgresql-client \
    libpq-dev \
    gcc \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy dependency files
COPY requirements.txt pyproject.toml* ./

# Install Python dependencies
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY . .

# Create necessary directories
RUN mkdir -p logs tmp data

# Create a non-root user
RUN useradd -m -u 1000 appuser && \
    chown -R appuser:appuser /app
USER appuser

# Expose the port
EXPOSE 8001

# Startup script
CMD ["sh", "-c", "\
    echo '⏳ Waiting for database...' && \
    sleep 5 && \
    echo '📦 Running migrations...' && \
    alembic upgrade head && \
    echo '🌱 Seeding initial data...' && \
    python scripts/seed_data.py 2>/dev/null || true && \
    python scripts/bootstrap_users.py 2>/dev/null || true && \
    echo '🚀 Starting server...' && \
    uvicorn app.main:app --host 0.0.0.0 --port 8001 \
"]
